# =========================================================================
# 📋 Plantilla de Configuración de Terraform para Oracle Cloud (OCI)
# Copia este archivo a 'terraform.tfvars' y completa tus valores reales.
# =========================================================================

# ── Credenciales OCI (Obtenidas de tu perfil en OCI Console) ──
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
user_ocid        = "ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
compartment_id   = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # O el tenancy_ocid si usas el root

# ── Región OCI ──
# Santiago: sa-santiago-1 | São Paulo: sa-saopaulo-1 | Ashburn: us-ashburn-1 | Phoenix: us-phoenix-1
region           = "sa-santiago-1"
environment      = "production"

# ── Especificaciones de la Máquina Virtual (OCI Free Tier Ampere ARM) ──
instance_name           = "crystaltides-core-vm"
instance_shape          = "VM.Standard.A1.Flex"
instance_ocpus          = 4    # Máximo permitido en Always Free
instance_memory_in_gbs  = 24   # Máximo permitido en Always Free
boot_volume_size_in_gbs = 100  # OCI te da 200 GB gratis en total
assign_reserved_public_ip = true

# ── Clave SSH Pública para acceder a la máquina ──
# Pega aquí el contenido de tu id_rsa.pub o id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... nacho@tu-pc"

# ── Automatización DNS en Cloudflare (Opcional) ──
enable_cloudflare    = false
# cloudflare_api_token = "tu_token_de_cloudflare_con_permisos_dns"
# cloudflare_zone_id   = "tu_zone_id_de_cloudflare"
# domain_name          = "crystaltidessmp.net"
