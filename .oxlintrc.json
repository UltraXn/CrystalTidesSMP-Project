{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "jsx-a11y", "oxc"],
  "categories": {
    "correctness": "warn",
    "perf": "warn",
    "suspicious": "warn"
  },
  "jsPlugins": [
    {
      "name": "react-doctor",
      "specifier": "oxlint-plugin-react-doctor"
    }
  ],
  "rules": {
    // React 19 & JSX moderno: React ya no necesita estar en el scope global en Vite/SWC
    "react/react-in-jsx-scope": "off",

    // Variables no usadas: delegar a typescript para evitar colisiones con tipos/interfaces
    "no-unused-vars": "off",
    "typescript/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],

    // Tipado estricto: alertar sobre 'any' para fomentar interfaces compartidas en @crystaltides/shared
    "typescript/no-explicit-any": "warn",

    // Registro de logs: permitir niveles estándar de observabilidad pero prevenir logs residuales huérfanos
    "no-console": ["warn", { "allow": ["log", "error", "warn", "info", "debug"] }],

    // Integridad de Hooks: prohibir condicionales en hooks (violación crítica de ciclo de vida de React)
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",

    // Accesibilidad WCAG 2.2: roles semánticos y soporte para elementos no-DOM
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/aria-role": ["warn", { "ignoreNonDOM": true }],
    "jsx-a11y/no-static-element-interactions": [
      "warn",
      { "handlers": ["onClick", "onKeyDown", "onKeyUp", "onKeyPress"] }
    ],

    // Compatibilidad React Compiler: desactivadas las reglas en conflicto con librerías de terceros (Three.js/Embla)
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react-hooks/set-state-in-effect": "off",
    "react-hooks/immutability": "off",
    "react-hooks/incompatible-library": "off",

    // Mapeo inmutable en React: en React es idiomático hacer items.map(x => ({ ...x, nuevo: val }))
    "oxc/no-map-spread": "off",

    // --- SUITE REACT DOCTOR (Salud Arquitectónica y Detección de Fugas) ---
    // Animaciones Framer Motion: AnimatePresence debe mantenerse montado para ejecutar exit animations.
    // (Resuelto a nivel de código encapsulando menús y modales en subcomponentes atómicos)
    "react-doctor/motion-animate-presence-must-outlive-child": "warn",

    // Prevención de memory leaks: detección de fetch directo en useEffect sin AbortController ni React Query
    "react-doctor/no-fetch-in-effect": "warn",

    // Rendimiento: evitar derivar estado mediante useEffect (calcularlo inline o via useMemo)
    "react-doctor/no-derived-state-effect": "warn",

    // Seguridad Web: aislar iframes de contenido externo con atributos sandbox restrictivos
    "react-doctor/iframe-missing-sandbox": "warn",

    // Accesibilidad a11y: prevenir inputs que solo dependen de placeholder sin label para lectores de pantalla
    "react-doctor/no-placeholder-only-field": "warn",

    // Seguridad XSS: auditar puntos de inyección HTML sin sanitizar
    "react-doctor/dangerous-html-sink": "warn",

    // Ciclo de vida y memory leaks: verificar que timers, listeners o suscripciones tengan return de limpieza
    "react-doctor/effect-needs-cleanup": "warn",

    // Estándar HTML5: exigir atributo type explícito en botones ('button' o 'submit') para evitar submit accidental
    "react-doctor/button-has-type": "warn",

    // JUSTIFICACIÓN [React Router v7]: El monorepo estandariza en react-router-dom v7 (^7.16.0), el paquete
    // canónico para aplicaciones Web/DOM. Esta regla genera falsos positivos masivos al anticipar react-router v8
    // (no publicado como estable), penalizando imports oficiales de enrutamiento web válidos.
    "react-doctor/react-router-v8-no-react-router-dom-import": "off",

    // JUSTIFICACIÓN [Diseño Modular vs Vistas Contenedor]: El límite rígido de 300 LOC es arbitrario e inflexible.
    // Páginas completas (Rules.tsx, vistas de administración) coordinan legítimamente el layout sin violar responsabilidades.
    // La modularidad del código se audita mediante Complejidad Cognitiva <= 15 (SonarQube) y no por recuento ciego de líneas.
    "react-doctor/no-giant-component": "off",

    // JUSTIFICACIÓN [Renderizado Matemático / Canvas / SVG]: Componentes que generan rutas SVG complejas,
    // gráficos radar de Recharts o transformaciones matriciales 3D requieren ramas matemáticas inherentes
    // que exceden el umbral sintáctico de complejidad de funciones de react-doctor.
    "react-doctor/no-high-complexity-react-function": "off",

    // JUSTIFICACIÓN [Express 5.2.1 Native Async Support]: El backend utiliza Express 5.2.1, donde los handlers
    // de ruta async con Promises son soportados de forma nativa por el motor de enrutamiento y cualquier
    // rechazo se reenvía automáticamente a next(err). Esta regla fue concebida para Express 4 (donde un rejection
    // no capturado terminaba el proceso Node) y es un antipatrón en Express 5 que forzaría wrappers innecesarios.
    "oxc/no-async-endpoint-handlers": "off",

    // JUSTIFICACIÓN [Bucles Asíncronos Secuenciales Intencionados]: En apps/discord-bot (despliegue de comandos y presencias)
    // y en llmFallbackPipeline.ts (failover en cascada entre proveedores IA), las peticiones deben ejecutarse en serie para
    // respetar los límites de tasa de la API (HTTP 429) o evaluar proveedores secuencialmente. En el frontend (Gacha),
    // el bucle secuencia las pausas de animación (setTimeout). Usar Promise.all rompería el control de flujo temporal y rate limits.
    "no-await-in-loop": "off",

    // JUSTIFICACIÓN [Servicios Estáticos de Integración]: En apps/discord-bot y apps/web-server, clases como PelicanService,
    // MinecraftService y WOLService encapsulan métodos estáticos para actuar como espacios de nombres modulares hacia APIs externas
    // sin requerir instanciación en memoria.
    "typescript/no-extraneous-class": "off",

    // JUSTIFICACIÓN [Variables de Entorno ESM & Parámetros Ignorados]: En módulos Node.js ESM es estándar reconstruir
    // __filename y __dirname mediante fileURLToPath. Asimismo, los callbacks de TypeScript emplean el prefijo '_' para
    // parámetros intencionalmente no leídos (_req, _next).
    "no-underscore-dangle": "off",

    // JUSTIFICACIÓN [Ciclo de Vida Efímero en Web APIs]: Las instancias de un solo uso de FileReader y new Image() para
    // precargas de texturas WebGL y carga de imágenes asignan handlers directamente (.onload, .onerror), lo cual es idiomático
    // en navegadores para objetos de recolección inmediata sin overhead de suscripción múltiple.
    "unicorn/prefer-add-event-listener": "off",

    // JUSTIFICACIÓN [Callbacks Render Props en Librerías de Terceros]: Librerías de drag & drop (@hello-pangea/dnd)
    // utilizan funciones hijas (provided) => <div ...>. El análisis sintáctico de oxlint las confunde erróneamente con
    // componentes React anidados inestables cuando en realidad son render props puras.
    "react/no-unstable-nested-components": "off",

    // JUSTIFICACIÓN [Elementos SVG Decorativos Inmutables]: Gráficos matemáticos (polígonos de radar charts, marcas de ejes
    // y cuadrículas vectoriales) no poseen identificadores de base de datos. Utilizar el índice de iteración para elementos
    // SVG estáticos que nunca se reordenan es seguro y no genera desalineación de reconciliación DOM.
    "react/no-array-index-key": "off",

    // JUSTIFICACIÓN [Hooks de Montaje Inicial vs Compilador]: El proyecto audita dependencias de hooks mediante
    // react-hooks/exhaustive-deps ("warn"). Esta regla adicional del analizador oxc genera falsos positivos sobre suscripciones
    // intencionales de ciclo de vida con array vacío ([]).
    "react/exhaustive-effect-dependencies": "off",
    "react/memo-dependencies": "off",

    // JUSTIFICACIÓN [Variables de Ámbito Convencionales]: Cláusulas de captura (catch (err)), eventos de formulario (e) y
    // argumentos de callbacks utilizan nombres canónicos reconocibles. Renombrarlos forzosamente degrada la claridad del código.
    "no-shadow": "off",

    // JUSTIFICACIÓN [Ordenamiento Inmutable Copiado]: Vistas como Rules.tsx clonan previamente el arreglo ([...rules].sort(...))
    // antes de ordenar por prioridad, garantizando que el estado original no sea mutado sin requerir Array.toSorted() (ES2023).
    "unicorn/no-array-sort": "off",

    // JUSTIFICACIÓN [Interacción en Visores 3D / HUD]: Componentes como WikiMerchant3DCard requieren manejadores de interacción
    // y navegación por teclado (tabIndex) en contenedores no semánticos de Canvas WebGL para interactuar con la cámara Three.js.
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",

    // JUSTIFICACIÓN [Declaraciones Ambientales TypeScript]: En archivos .d.ts (como express.d.ts), `export {};` es el
    // estándar oficial de TypeScript para transformar el archivo en módulo ES y habilitar la aumentación `declare global`.
    // Prohibir llaves vacías en archivos de tipado ambiental rompe la compilación de TypeScript.
    "unicorn/require-module-specifiers": "off",

    // JUSTIFICACIÓN [Encapsulación de Funciones Auxiliares]: Funciones y helpers puros definidos dentro de módulos o
    // componentes (formateadores, handlers de mock en tests, generadores de visuales) se mantienen en su ámbito local para
    // preservar la cohesión y privacidad del módulo sin forzar su elevación al ámbito global.
    "unicorn/consistent-function-scoping": "off",

    // JUSTIFICACIÓN [Carga de Modelos WebGL / Canvas en Three.js]: Vistas 3D interactivas (servidores en rack, altares y
    // modelos GLTF de Blockbench) cargan modelos geométricos locales dentro del ciclo de vida del Canvas WebGL (useEffect).
    // Esta regla está orientada a datos de UI y no es aplicable al streaming de buffers matriciales en WebGL.
    "react-doctor/no-fetch-in-effect": "off",
    "react-doctor/effect-needs-cleanup": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/node_modules/**",
    "**/storybook-static/**",
    "**/src-tauri/target/**",
    "**/target/**",
    // Apps de escritorio Tauri / Rust: gestionan su propio pipeline de linter y contienen junctions NTFS
    "apps/launcher/**",
    "apps/launcher/**/*",
    "apps/launcher-lite/**",
    "**/apps/launcher/**",
    "**/apps/launcher/**/*",
    "**/apps/launcher-lite/**",
    "**/launcher/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.stryker-tmp/**",
    "crystaltides.tar.gz",
    "*.cjs",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test-utils.tsx",
    "**/*.stories.*",
    "**/stories/**"
  ]
}
