{
  "name": "@crystaltides/game-bridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:java": "pwsh -NoProfile -ExecutionPolicy Bypass -File java-agent/build-agent.ps1",
    "sync:assets": "pwsh -NoProfile -Command \"Copy-Item 'java-agent/target/game-bridge-1.0-SNAPSHOT.jar' '../launcher-lite/src-tauri/assets/game-bridge.jar' -Force; Write-Host 'Assets synchronized'\"",
    "build": "npm run build:java && npm run sync:assets",
    "test": "cd java-agent && mvn -q test"
  }
}
