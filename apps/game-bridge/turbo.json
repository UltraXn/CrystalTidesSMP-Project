    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "java-agent/src/**",
        "java-agent/pom.xml",
        "java-agent/checkstyle.xml",
        "!java-agent/target/**"
      ],
      "outputs": [],
      "env": []
    }
  }
}
