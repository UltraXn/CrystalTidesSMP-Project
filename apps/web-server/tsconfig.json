{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": [
    "index.ts",
    "app.ts",
    "config/**/*.ts",
    "controllers/**/*.ts",
    "routes/**/*.ts",
    "services/**/*.ts",
    "middleware/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "schemas/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "reports",
    "__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "scripts/**",
    "vitest.config.ts",
    "eslint.config.js"
  ]
}
