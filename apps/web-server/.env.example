# Configuración del Servidor
# 🌐 Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://tu-dominio.com

# 🔑 Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# 🤖 Discord (Webhooks / Bot)
DISCORD_WEBHOOK_URL=url-webhook-general
DISCORD_NEWS_WEBHOOK_URL=url-webhook-noticias
DISCORD_FORUM_WEBHOOK=url-webhook-foro
DISCORD_MC_EVENTS_WEBHOOK=url-webhook-eventos-mc
BOT_API_KEY=tu-clave-compartida-con-el-bot
BOT_API_URL=http://localhost:3002

# ☁️ Cloudflare R2
R2_ACCESS_KEY=tu-access-key
R2_SECRET_KEY=tu-secret-key
R2_BUCKET_NAME=nombre-del-bucket
R2_ENDPOINT=https://tu-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://public-url.com

# 🎮 Minecraft (Pterodactyl)
PTERODACTYL_API_KEY=tu-api-key-de-panel
PTERODACTYL_SERVER_ID=id-del-servidor
PTERODACTYL_HOST=https://panel.tu-host.com
MC_SERVER_HOST=localhost
MC_SERVER_PORT=25565
MC_WEBHOOK_SECRET=token-secreto-para-recepcion-de-webhooks

# 📊 Integraciones
NOTION_API_KEY=tu-notion-api-key
NOTION_DATABASE_ID=id-de-la-db
GOOGLE_CALENDAR_ID=tu-id-de-calendario
GOOGLE_SERVICE_ACCOUNT_EMAIL=email-de-servicio
GOOGLE_PRIVATE_KEY=clave-privada-google
TWITCH_CLIENT_ID=tu-twitch-id
TWITCH_CLIENT_SECRET=tu-twitch-secret
KOFI_VERIFICATION_TOKEN=tu-kofi-token
TWO_FACTOR_LOGO_URL=url-del-logo-para-2fa
