# Configuración del Servidor
PORT=3001
NODE_ENV=production
MOCK_DATABASE=false

# Supabase (Base de datos)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Obligatorias: config/env.ts las valida al arrancar (tras Vault) y el proceso sale con
# código 1 si faltan o miden menos de 32 caracteres. Cada una con su propio valor.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_JWT_SECRET=
COOKIE_SECRET=

# Ko-Fi (Opcional si configuras token de verificación)
KOFI_VERIFICATION_TOKEN=tu-token-si-tienes

# HashiCorp Vault (Opcional, con fallback a .env)
# Nunca el token root: un token periódico con la política de deploy/vault/web-server.hcl
# (solo lectura de VAULT_SECRET_PATH). Ver docs/operations/web-server-secrets.md.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/crystaltides

# Google Gemini AI (Opcional para validación de sugerencias e IA)
GEMINI_API_KEY=tu-gemini-api-key

# Microsoft OAuth / Minecraft Device Code Flow (Para vinculación de cuentas Minecraft)
MICROSOFT_CLIENT_ID=tu-azure-client-id
MICROSOFT_LIVE_CLIENT_ID=tu-live-client-id
MICROSOFT_CLIENT_SECRET=tu-azure-client-secret-opcional

# 2FA: clave AES-256 para cifrar los secretos TOTP en la tabla user_totp_secrets.
# 32 bytes en base64. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin ella, el 2FA devuelve 503 y las acciones de admin protegidas quedan bloqueadas (falla cerrado).
TOTP_ENCRYPTION_KEY=

# Días que se conservan los registros de auditoría (system_logs). Por defecto: 90.
LOG_RETENTION_DAYS=90

# Proxies de confianza delante del servidor (Cloud Run = 1). Sumar uno por cada balanceador extra.
# La IP real detrás de Cloudflare se toma de CF-Connecting-IP solo si el peer es de Cloudflare.
TRUST_PROXY_HOPS=1

# WebSocket /ws del plugin CrystalCore: token compartido (mín. 32 caracteres) que el plugin envía como Bearer
# (clave websocket-token en su config.yml). Sin él, todas las conexiones WS se rechazan
# y el plugin solo recibe comandos por el sondeo de la cola cada 10 s.
BRIDGE_WS_TOKEN=
