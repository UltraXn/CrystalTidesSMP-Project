#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────────────────────
# CrystalTides Pre-push Hook — Guardrails against repo corruption & leaks
# ─────────────────────────────────────────────────────────────────────────────

current_branch=$(git branch --show-current)

# 1. Block accidental direct push to main
if [ "$current_branch" = "main" ]; then
  echo "❌ [PRE-PUSH GUARD] Direct push to 'main' is prohibited by GitFlow policy."
  echo "👉 Push to 'develop' or open a Pull Request."
  exit 1
fi

# 2. Guard against committing secret files (.env, *.pem, id_rsa) but allow .example / .template
secret_patterns='(\.env(\.(local|production|development|staging|test))?$|.*id_rsa.*|.*\.pem$|.*\.key$)'
leaked_files=$(git diff --name-only @{u}..HEAD 2>/dev/null | grep -E "$secret_patterns" | grep -v -E '\.(example|sample|template)$' || true)

if [ -n "$leaked_files" ]; then
  echo "❌ [PRE-PUSH GUARD] Detected potential secret files in outgoing commits:"
  echo "$leaked_files"
  echo "👉 Remove secrets before pushing to remote."
  exit 1
fi

# 3. Guard against committing huge binary blobs (> 15MB) - fast single-pass check
large_files=$(find . -maxdepth 4 -not -path '*/.*' -not -path '*/node_modules/*' -not -path '*/target/*' -size +15M 2>/dev/null || true)

if [ -n "$large_files" ]; then
  echo "❌ [PRE-PUSH GUARD] Detected large binary file (> 15MB) in repository tree:"
  echo "$large_files"
  echo "👉 Upload heavy 3D assets to Cloudflare R2 instead of Git."
  exit 1
fi

echo "✅ [PRE-PUSH GUARD] All pre-push checks passed."
exit 0
