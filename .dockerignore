out/
windows/
native/
apps/launcher


# OS specific and misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
**/.env
**/.env.*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
desktop.ini
