# Optimized .dockerignore for Crystaltides Monorepo
# Exclude build artifacts, local secrets, and unnecessary files

**/node_modules
**/dist
**/coverage
**/.turbo
**/.next
**/.cache

# Secret files (CRITICAL SECURITY PROTECTION)
.env
.env.*
.env.local
.env.production
.env.development
**/.env
**/.env.*
**/.env.local
**/.env.production
**/.env.development
*.pem
*.key
*.crt
*.p12
*.secret
secrets/
**/secrets/

# Root heavy directories
.git
.github
.vscode
.idea
.agent
.agents
.claude
.opencode
graphify-out
target/
database/
plugins/
temp/
tmp/
out/
windows/
native/
apps/launcher

# OS specific and misc
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db
desktop.ini
