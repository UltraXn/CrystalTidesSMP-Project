{
  "$schema": "https://json.schemastore.org/package",
  "name": "crystaltides-app",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.6.4",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "client": "npm run dev -w @crystaltides/client",
    "server": "npm run dev -w @crystaltides/server",
    "dev:lite": "npm run dev -w @crystaltides/launcher-lite",
    "install:all": "npm install",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "overrides": {
    "glob": "11.1.0",
    "esbuild": "0.27.2",
    "cross-spawn": "7.0.6",
    "tar": "7.5.19",
    "undici": "7.28.0",
    "fast-xml-parser": "5.7.0",
    "rollup": "4.59.0",
    "flatted": "3.4.2",
    "lodash": "4.18.1",
    "lodash-es": "4.17.21",
    "qs": "6.15.3",
    "diff": "8.0.3",
    "express-rate-limit": "8.3.1",
    "ws": "8.21.0",
    "postcss": "8.5.10",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "form-data": "4.0.6",
    "fast-uri": "3.1.3",
    "multer": "2.2.0",
    "shell-quote": "1.8.4",
    "js-yaml": "4.2.0",
    "@babel/core": "7.29.7",
    "vite": "6.4.3",
    "turbo": "2.9.14",
    "ip-address": "9.0.5",
    "tinyglobby": {
      "glob": "11.1.0"
    },
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@crystaltides/client": {
      "typescript": "7.0.2"
    },
    "@crystaltides/server": {
      "typescript": "7.0.2"
    },
    "@crystaltides/shared": {
      "typescript": "7.0.2"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tauri-apps/cli": "^2.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.0.0",
    "cross-spawn": "7.0.6",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-glob": "^3.3.3",
    "glob": "11.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^17.5.0",
    "micromatch": "^4.0.8",
    "opencode-plugin-llama.cpp": "^0.1.0",
    "postcss": "8.5.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^8.6.14",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.1.18",
    "turbo": "2.9.14",
    "typescript-eslint": "^8.50.1",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@supabase/phoenix": "^0.4.5",
    "@supabase/supabase-js": "^2.89.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.2",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "tar": "7.5.19"
  }
}
